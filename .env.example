# Copy this file to .env and adjust as needed. All values are optional —
# sensible defaults are baked into config.py.

# Where to look for grade textbooks and where to persist the vector store.
# GRADE_PDFS_DIR=grade_pdfs
# CHROMA_PERSIST_DIR=chroma_db

# Chunking
# CHUNK_SIZE=500
# CHUNK_OVERLAP=80

# Retrieval
# EMBEDDING_MODEL_NAME=all-mpnet-base-v2
# TOP_K=4
# RELEVANCE_DISTANCE_THRESHOLD=0.9

# Local LLM served via Ollama (https://ollama.com)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_TIMEOUT_SECONDS=60
